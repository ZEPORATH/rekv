FROM node:22-alpine AS web-build
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.23-alpine AS go-build
WORKDIR /src
COPY clients/go/go.mod clients/go/go.sum ./
RUN go mod download
COPY clients/go/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/rekv-web ./cmd/demo-server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=go-build /out/rekv-web /app/rekv-web
COPY --from=web-build /src/web/dist /app/web
EXPOSE 8090
ENTRYPOINT ["/app/rekv-web"]
CMD ["--target", "configd:50051", "--listen", "0.0.0.0:8090", "--web-root", "/app/web"]
